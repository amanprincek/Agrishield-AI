# AgriShield-AI — Environment template
# Copy to .env and fill with local values. Never commit real passwords.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agrishield
DATABASE_URL=
# Optional: override full SQLAlchemy URL (takes precedence over DB_* above)
# Example: mysql+pymysql://root:password@localhost:3306/agrishield
# For SQLite fallback (no MySQL): sqlite:///./agrishield.db

# CORS — comma-separated origins for FastAPI CORSMiddleware
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if not set
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Alternative name:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
